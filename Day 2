import sys
import heapq

def solve():
    # Fast I/O for handling up to 200,000 queries efficiently
    input = sys.stdin.read
    data = input().split()
    
    if not data:
        return

    q = int(data[0])
    
    # min_heap will store tuples of (deadline, id)
    min_heap = []
    
    # Dictionary to keep track of the current active deadline of each parcel ID.
    # If an ID is not present or maps to None, it means it's not currently on the shelves.
    current_deadline = {}
    
    idx = 1
    output = []
    
    for _ in range(q):
        msg_type = data[idx]
        idx += 1
        
        if msg_type == "ARRIVE":
            pid = int(data[idx])
            deadline = int(data[idx+1])
            idx += 2
            current_deadline[pid] = deadline
            heapq.heappush(min_heap, (deadline, pid))
            
        elif msg_type == "DELAY":
            pid = int(data[idx])
            deadline = int(data[idx+1])
            idx += 2
            current_deadline[pid] = deadline
            heapq.heappush(min_heap, (deadline, pid))
            
        elif msg_type == "CANCEL":
            pid = int(data[idx])
            idx += 1
            current_deadline[pid] = None
            
        elif msg_type == "DISPATCH":
            loaded_id = -1
            
            # Pop elements until we find a valid entry that matches the current tracking state
            while min_heap:
                deadline, pid = heapq.heappop(min_heap)
                
                # Check if this heap entry is still valid and active
                if current_deadline.get(pid) == deadline:
                    loaded_id = pid
                    break
            
            if loaded_id != -1:
                output.append(str(loaded_id))
                current_deadline[loaded_id] = None # Remove permanently from the shelf
            else:
                output.append("IDLE")
                
    # Print all outputs separated by a newline
    sys.stdout.write("\n".join(output) + "\n")

if __name__ == '__main__':
    solve()
